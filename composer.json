{
    "name": "lee-to/yii-blade",
    "type": "library",
    "description": "Blade template engine support",
    "keywords": [
        "yii",
        "blade"
    ],
    "homepage": "https://cutcode.dev",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/lee-to/yii-blade/issues?state=open",
        "source": "https://github.com/lee-to/yii-blade"
    },
    "funding": [
        {
            "type": "boosty",
            "url": "https://boosty.com/cutcode"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/view": "^12",
        "yiisoft/definitions": "^3.4",
        "yiisoft/view": "^12.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Leeto\\YiiBlade\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Leeto\\YiiBlade\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit",
        "coverage": [
            "php -d xdebug.mode=coverage vendor/bin/phpunit --coverage-clover build/logs/clover.xml --coverage-text --colors=never",
            "php tests/check-coverage.php build/logs/clover.xml"
        ]
    },
    "extra": {
        "config-plugin-options": {
            "source-directory": "config"
        },
        "config-plugin": {
            "params": "params.php",
            "di": "di.php"
        }
    },
    "config": {
        "sort-packages": true
    }
}
